    { "itemId": 5004, "buyPrice": 220, "sellPrice": 90 },
    { "itemId": 5017, "buyPrice": 180, "sellPrice": 60 },
    { "itemId": 5018, "buyPrice": 200, "sellPrice": 80 },
    // null 表示该店不卖这件商品，但仍允许回收。
    { "itemId": 5022, "buyPrice": null, "sellPrice": 120 }
  ]
}
